# Environment for gamma2mqtt.service. Every CLI option maps to GAMMA_<OPTION>.
GAMMA_PORT=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART-XXXXXXXX-if00-port0
GAMMA_MQTT_HOST=homeassistant.local
GAMMA_MQTT_PORT=1883
GAMMA_MQTT_USER=mqtt
GAMMA_MQTT_PASSWORD=change-me
GAMMA_TOPIC_PREFIX=gamma2mqtt
GAMMA_DISCOVERY_PREFIX=homeassistant
GAMMA_STALE_TIMEOUT=60
GAMMA_REPUBLISH_INTERVAL=300
GAMMA_LOG_LEVEL=INFO
# GAMMA_PUBLISH_RAW=1
